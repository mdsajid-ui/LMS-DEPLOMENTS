# Server Configuration
PORT=5000
NODE_ENV=production

# UpCloud Object Storage (S3-Compatible)
S3_ENDPOINT=https://t8fcc.upcloudobjects.com
S3_BUCKET=b1storage
S3_ACCESS_KEY=your_upcloud_access_key
S3_SECRET_KEY=your_upcloud_secret_key
S3_REGION=us-east-1
S3_PUBLIC_URL=https://b1storage.t8fcc.upcloudobjects.com

# SQL Database Configuration (MySQL 8.0 / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=dv_analytics_lms
